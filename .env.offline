# Docker 대신 로컬 프로세스 런타임 (ProcessSandboxService)
RUNTIME=local

# GitHub 완전 비활성화 (미설정 → UI에 GitHub 버튼 미표시)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_TOKEN=

# Tavily 인터넷 검색 비활성화 (미설정 → 서버 시작 시 자동 skip)
TAVILY_API_KEY=
SEARCH_API_KEY=

# PostHog 텔레메트리 비활성화
DISABLE_ANALYTICS=true

# vLLM 원격 엔드포인트 (워크스테이션을 경유한 서버 주소)
# 아래 WORKSTATION_IP 와 PORT 를 실제 값으로 교체하세요
LLM_BASE_URL=http://WORKSTATION_IP:PORT/v1
